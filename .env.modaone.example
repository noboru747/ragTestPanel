# ModaOne（OpenAI 相容 API）設定範本
# 複製為 .env.modaone 後填入值（.env.modaone 已被 .gitignore 排除，勿 commit）
# 搭配：docker compose -f docker-compose.yml -f docker-compose.modaone.yml up -d backend

# 各功能供應商：ollama（預設）| openai
LLM_PROVIDER=openai
EMBED_PROVIDER=openai
VISION_PROVIDER=openai

# OpenAI 相容 base_url —— 填到 /api/v1 為止，不含 /chat/completions
# （同一 base_url 下 /chat/completions、/embeddings、/models 皆可用）
OPENAI_BASE_URL=https://modaone-llm-api.dginfra.gov.tw/api/v1

# API Key（Header 會送 Authorization: Bearer <key>）
OPENAI_API_KEY=

# 文字生成模型。其他可用：gpt-oss-120b、Gemma-3-TAIDE-12b-Chat、Llama-3.1-TAIDE-LX-8B-Chat
# 完整清單：GET {OPENAI_BASE_URL}/models（需帶 Authorization header）
OPENAI_MODEL=Llama-3.3-70B-Instruct

# Embedding 模型：bge-m3 輸出 1024 維 → 資料庫需用 rga_km_modaone（vector(1024)）
OPENAI_EMBED_MODEL=bge-m3
# 送 embedding 前的截斷字數。bge-m3 上限 8192 tokens；實測純中文約 0.79 token/字、
# 中英混合約 0.54 token/字 → 6000 字約 4.7k tokens，保留罕用字/符號的安全邊際
EMBED_MAX_CHARS=6000

# 圖片 OCR 視覺模型（實測中文表格 OCR 最準）；備選 gemma-4-26B-A4B-it、Llama-4-Maverick-17B-128E-Instruct-FP8
OPENAI_VISION_MODEL=gemma-4-31B-it

# 請求逾時秒數（選填）
OPENAI_TIMEOUT=180
